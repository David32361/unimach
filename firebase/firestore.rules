rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function activeUser(userId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'active';
    }

    function matchParticipant(matchId) {
      return signedIn()
        && activeUser(request.auth.uid)
        && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.userIds;
    }

    function conversationParticipant(conversationId) {
      return signedIn()
        && activeUser(request.auth.uid)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    function blockedBetween(user1, user2) {
      return exists(/databases/$(database)/documents/blocks/$(user1 + '_' + user2))
        || exists(/databases/$(database)/documents/blocks/$(user2 + '_' + user1));
    }

    function validInterestFields(data) {
      let genres = data.get('animeGenres', []);
      return data.interests is list
        && data.interests.size() <= 30
        && data.interests.toSet().size() == data.interests.size()
        && data.interests.hasOnly([
          'movies_action', 'movies_horror', 'movies_comedy',
          'movies_romance', 'movies_fantasy', 'movies_scifi',
          'music_rock', 'music_pop', 'music_electronic',
          'music_rap', 'music_regional', 'music_classical',
          'sports_soccer', 'sports_basketball', 'sports_swimming',
          'sports_gym', 'sports_athletics',
          'games_rpg', 'games_fps', 'games_strategy',
          'games_moba', 'games_sports',
          'books_fantasy', 'books_scifi', 'books_romance',
          'books_mystery', 'books_horror', 'anime'
        ])
        && genres is list
        && genres.size() <= 14
        && genres.toSet().size() == genres.size()
        && genres.hasOnly([
          'anime_action', 'anime_adventure', 'anime_comedy',
          'anime_drama', 'anime_fantasy', 'anime_horror',
          'anime_isekai', 'anime_mecha', 'anime_mystery',
          'anime_romance', 'anime_scifi', 'anime_slice_of_life',
          'anime_sports', 'anime_supernatural'
        ]);
    }

    function validInterestSelection(data) {
      let genres = data.get('animeGenres', []);
      return data.interests.size() >= 3
        && (('anime' in data.interests && genres.size() >= 3)
          || (!('anime' in data.interests) && genres.size() == 0));
    }

    function validPublicProfile(userId, data) {
      return data.keys().hasOnly([
          'uid',
          'name',
          'age',
          'gender',
          'university',
          'career',
          'description',
          'avatarId',
          'interests',
          'animeGenres',
          'createdAt',
          'updatedAt',
          'accountStatus'
        ])
        && data.uid == userId
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.age is int
        && data.age >= 18
        && data.age <= 99
        && data.gender is string
        && data.gender.size() > 0
        && data.university is string
        && data.university.size() > 0
        && data.university.size() <= 120
        && data.career is string
        && data.career.size() > 0
        && data.career.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 300
        && data.avatarId is int
        && data.avatarId >= 0
        && data.avatarId < 12
        && validInterestFields(data)
        && data.accountStatus in ['active', 'suspended', 'banned', 'deleted'];
    }

    function validProfile(userId, data) {
      return data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'age',
          'gender',
          'university',
          'career',
          'description',
          'avatarId',
          'interests',
          'animeGenres',
          'createdAt',
          'lastActivity',
          'accountStatus',
          'profileComplete'
        ])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.age is int
        && data.age >= 18
        && data.age <= 99
        && data.gender is string
        && data.gender.size() > 0
        && data.university is string
        && data.university.size() > 0
        && data.university.size() <= 120
        && data.career is string
        && data.career.size() > 0
        && data.career.size() <= 120
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 300
        && data.avatarId is int
        && data.avatarId >= 0
        && data.avatarId < 12
        && validInterestFields(data)
        && data.accountStatus in ['active', 'suspended', 'banned', 'deleted']
        && data.profileComplete == true;
    }

    match /users/{userId} {
      allow get: if owns(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if owns(userId)
        && validProfile(userId, request.resource.data)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.interests.size() == 0
        && request.resource.data.get('animeGenres', []).size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastActivity == request.time;

      allow update: if (owns(userId)
          && validProfile(userId, request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'interests', 'animeGenres'
          ]) || validInterestSelection(request.resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'avatarId',
            'description',
            'university',
            'career',
            'interests',
            'animeGenres',
            'lastActivity'
          ]))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountStatus'
          ])
          && request.resource.data.accountStatus in [
            'active',
            'suspended',
            'banned',
            'deleted'
          ]);

      allow delete: if false;

      match /passes/{targetUserId} {
        allow read: if owns(userId);
        allow create: if owns(userId)
          && activeUser(userId)
          && userId != targetUserId
          && request.resource.data.keys().hasOnly([
            'userId',
            'targetUserId',
            'createdAt'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.targetUserId == targetUserId
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }

      match /devices/{deviceId} {
        allow read: if owns(userId);
        allow create, update: if owns(userId)
          && activeUser(userId)
          && request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'updatedAt'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 500
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAt == request.time;
        allow delete: if owns(userId);
      }

      match /sessions/{sessionId} {
        allow read: if owns(userId) || isAdmin();
        allow create: if owns(userId)
          && activeUser(userId)
          && request.resource.data.keys().hasOnly([
            'userId',
            'startedAt',
            'endedAt',
            'durationSeconds'
          ])
          && request.resource.data.userId == userId
          && request.resource.data.startedAt == request.time
          && request.resource.data.endedAt == null
          && request.resource.data.durationSeconds == 0;
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'endedAt',
            'durationSeconds'
          ])
          && resource.data.endedAt == null
          && request.resource.data.endedAt == request.time
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds >= 0
          && request.resource.data.durationSeconds <= 86400;
        allow delete: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow get: if isAdmin()
        || (signedIn()
          && activeUser(request.auth.uid)
          && (owns(userId) || resource.data.accountStatus == 'active'));
      allow list: if isAdmin()
        || (signedIn()
          && activeUser(request.auth.uid)
          && request.query.limit <= 50
          && resource.data.accountStatus == 'active');

      allow create: if owns(userId)
        && validPublicProfile(userId, request.resource.data)
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.interests.size() == 0
        && request.resource.data.get('animeGenres', []).size() == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (owns(userId)
          && validPublicProfile(userId, request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'interests', 'animeGenres'
          ]) || validInterestSelection(request.resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'avatarId',
            'description',
            'university',
            'career',
            'interests',
            'animeGenres',
            'updatedAt'
          ]))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountStatus',
            'updatedAt'
          ])
          && request.resource.data.accountStatus in [
            'active',
            'suspended',
            'banned',
            'deleted'
          ]
          && request.resource.data.updatedAt == request.time);
      allow delete: if false;
    }

    match /likes/{likeId} {
      allow get: if signedIn()
        && activeUser(request.auth.uid)
        && (likeId.matches('^' + request.auth.uid + '_[^_]+$')
          || likeId.matches('^[^_]+_' + request.auth.uid + '$'));
      allow list: if signedIn()
        && activeUser(request.auth.uid)
        && (resource.data.senderId == request.auth.uid
          || resource.data.receiverId == request.auth.uid);
      allow create: if signedIn()
        && activeUser(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'senderId',
          'receiverId',
          'createdAt'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && activeUser(request.resource.data.receiverId)
        && !blockedBetween(
          request.resource.data.senderId,
          request.resource.data.receiverId
        )
        && likeId == request.resource.data.senderId + '_' + request.resource.data.receiverId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow get: if isAdmin()
        || (signedIn()
          && activeUser(request.auth.uid)
          && (matchId.matches('^' + request.auth.uid + '_[^_]+$')
            || matchId.matches('^[^_]+_' + request.auth.uid + '$')));
      allow list: if isAdmin()
        || (signedIn()
          && activeUser(request.auth.uid)
          && request.auth.uid in resource.data.userIds);
      allow create: if signedIn()
        && activeUser(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'matchId',
          'user1',
          'user2',
          'userIds',
          'createdAt',
          'status'
        ])
        && request.resource.data.matchId == matchId
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.resource.data.userIds.hasAll([
          request.resource.data.user1,
          request.resource.data.user2
        ])
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.user1 != request.resource.data.user2
        && activeUser(request.resource.data.user1)
        && activeUser(request.resource.data.user2)
        && !blockedBetween(
          request.resource.data.user1,
          request.resource.data.user2
        )
        && existsAfter(/databases/$(database)/documents/likes/$(request.resource.data.user1 + '_' + request.resource.data.user2))
        && existsAfter(/databases/$(database)/documents/likes/$(request.resource.data.user2 + '_' + request.resource.data.user1))
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'active';
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      // Transactions must be able to check whether their own conversation
      // exists before creating the match and conversation in the same commit.
      allow get: if isAdmin() || matchParticipant(conversationId)
        || (signedIn()
          && activeUser(request.auth.uid)
          && !exists(/databases/$(database)/documents/conversations/$(conversationId))
          && (conversationId.matches('^' + request.auth.uid + '_[^_]+$')
            || conversationId.matches('^[^_]+_' + request.auth.uid + '$')));
      allow list: if isAdmin()
        || (signedIn()
          && activeUser(request.auth.uid)
          && request.auth.uid in resource.data.participants);

      allow create: if signedIn()
        && activeUser(request.auth.uid)
        && request.auth.uid in getAfter(/databases/$(database)/documents/matches/$(conversationId)).data.userIds
        && request.resource.data.keys().hasOnly([
          'conversationId',
          'matchId',
          'participants',
          'lastMessage',
          'lastMessageAt',
          'lastSenderId',
          'createdAt'
        ])
        && request.resource.data.conversationId == conversationId
        && request.resource.data.matchId == conversationId
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && !blockedBetween(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && request.resource.data.participants.hasAll(
          getAfter(/databases/$(database)/documents/matches/$(conversationId)).data.userIds
        )
        && getAfter(/databases/$(database)/documents/matches/$(conversationId)).data.userIds.hasAll(
          request.resource.data.participants
        )
        && getAfter(/databases/$(database)/documents/matches/$(conversationId)).data.status == 'active'
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 1000
        && ((request.resource.data.lastMessage.size() == 0
            && request.resource.data.lastSenderId == '')
          || (request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastSenderId == request.auth.uid))
        && request.resource.data.lastMessageAt == request.time
        && request.resource.data.createdAt == request.time;

      allow update: if conversationParticipant(conversationId)
        && !blockedBetween(
          resource.data.participants[0],
          resource.data.participants[1]
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage',
          'lastMessageAt',
          'lastSenderId'
        ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() > 0
        && request.resource.data.lastMessage.size() <= 1000
        && request.resource.data.lastSenderId == request.auth.uid
        && request.resource.data.lastMessageAt == request.time;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if conversationParticipant(conversationId)
          || (isAdmin()
            && resource.data.timestamp >= request.time - duration.value(3, 'd'));
        allow create: if signedIn()
          && activeUser(request.auth.uid)
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !blockedBetween(
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
          )
          && request.resource.data.keys().hasOnly([
            'senderId',
            'text',
            'timestamp',
            'read'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.timestamp == request.time
          && request.resource.data.read == false;
        allow update: if conversationParticipant(conversationId)
          && !blockedBetween(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]
          )
          && resource.data.senderId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow delete: if false;
      }
    }

    match /blocks/{blockId} {
      allow read: if signedIn()
        && activeUser(request.auth.uid)
        && (resource.data.blockerId == request.auth.uid
          || resource.data.blockedUserId == request.auth.uid);
      allow create: if signedIn()
        && activeUser(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedUserId',
          'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId != request.auth.uid
        && activeUser(request.resource.data.blockedUserId)
        && blockId == request.resource.data.blockerId + '_' + request.resource.data.blockedUserId
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && activeUser(request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reportedUserId',
          'reason',
          'description',
          'createdAt',
          'status'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId != request.auth.uid
        && activeUser(request.resource.data.reportedUserId)
        && request.resource.data.reason in [
          'Spam',
          'Acoso',
          'Perfil falso',
          'Contenido inapropiado',
          'Comportamiento ofensivo',
          'Otro'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'pending';
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'reviewedBy',
          'reviewedAt'
        ])
        && request.resource.data.status in [
          'pending',
          'reviewing',
          'resolved',
          'rejected'
        ]
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /adminActions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'adminId',
          'userId',
          'reportId',
          'action',
          'previousStatus',
          'newStatus',
          'reason',
          'createdAt'
        ])
        && request.resource.data.adminId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.action in [
          'accountStatusChanged',
          'reportStatusChanged'
        ]
        && request.resource.data.previousStatus is string
        && request.resource.data.newStatus is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
